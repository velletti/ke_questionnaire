# [request && request.getQueryParams() && request.getQueryParams()['type'] == '2667']
#    page.typeNum = 2667
# [global]

keqAjaxResponse = PAGE
keqAjaxResponse {
    typeNum = 2667
    headerData >
    config {
        no_cache = 1

        # Ersetzt das veraltete disableAllHeaderCode
        disablePageHeaderAndFooter = 1

        # Neue Syntax für HTTP-Header ab v12/v13
        headers {
            10 {
                header = Content-Type: text/plain; charset=utf-8
            }
        }

        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
    }

    10 = USER_INT
    10 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = KeQuestionnaire
        pluginName = Questionnaire
        vendorName = Kennziffer
        controller = Ajax
        action = ajax

        # switchableControllerActions wurde ersatzlos entfernt.
        # Die Ziel-Action wird oben über "action = ajax" definiert.

        settings < plugin.tx_kequestionnaire.settings
        persistence < plugin.tx_kequestionnaire.persistence
    }
}
